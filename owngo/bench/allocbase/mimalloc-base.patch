+// mi_block_base returns the start of the block that contains p,
+// or NULL if p is not in a mimalloc page (OwnGo patch).
+mi_decl_nodiscard mi_decl_export void* mi_block_base(const void* p) mi_attr_noexcept {
+  mi_page_t* const page = _mi_safe_ptr_page(p);
+  if (page == NULL) return NULL;
+  return _mi_page_ptr_unalign(page, p);
+}
